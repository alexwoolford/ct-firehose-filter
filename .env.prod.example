# Copy to .env.prod on the host (do not commit secrets).
# Used with:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up --build -d

# Raw MatchEvent queue (edge → SQS).
SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/123456789012/ct-matches
# Optional A′ alerts queue (novelty consumer). Leave empty for alerts.jsonl only.
# NOVELTY_ALERTS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/123456789012/ct-alerts
AWS_REGION=us-west-2

# Full watchlist on the host (REQUIRED — never keywords.txt demo; EGRESS=sqs enforces min len).
WATCHLIST_HOST_PATH=/path/to/domains.txt
# Optional overrides (defaults: ./suppress.txt, ./glue.txt in the repo):
# SUPPRESS_HOST_PATH=./suppress.txt
# GLUE_HOST_PATH=./glue.txt

# Novelty: first cold start set 0 to create DB; then restore path or set 1 permanently.
NOVELTY_REQUIRE_DB=0
# Drop A′ coalitions larger than this (shared-vendor SAN junk). Default 5.
NOVELTY_MAX_COALITION=5
# Bound local alerts.jsonl (bytes); keep N rotated siblings.
NOVELTY_ALERTS_MAX_BYTES=52428800
NOVELTY_ALERTS_KEEP=3

# Credentials: set keys, OR leave empty and use an instance/workload role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
