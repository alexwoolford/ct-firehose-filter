# Copy to .env.prod on the host (do not commit secrets).
# Used with:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up --build -d
#
# Oracle VM standalone: EGRESS=novelty (in-process A′) — no cloud queues or object storage.
#
# Novelty paths (NOVELTY_DB / NOVELTY_ALERTS) are hardcoded in docker-compose.prod.yml to
# /var/lib/ct-firehose-filter/… — bind-mounted from the host. Inspect/backup on the host:
#   ls -la /var/lib/ct-firehose-filter/
#   tail -n 5 /var/lib/ct-firehose-filter/alerts.jsonl

# Full watchlist on the host (REQUIRED — never keywords.txt demo).
# Prod egress refuses watchlists shorter than WATCHLIST_MIN_LEN (default 100000).
# Example (local): WATCHLIST_HOST_PATH=/Users/you/domains.txt
# Example (Oracle): WATCHLIST_HOST_PATH=/var/lib/ct-firehose-filter/domains.txt
WATCHLIST_HOST_PATH=/var/lib/ct-firehose-filter/domains.txt

# Override only for deliberate tiny-list smokes (never on Oracle):
# WATCHLIST_MIN_LEN=0

# Novelty: first cold start leave 0 to create DB; then set 1 permanently.
NOVELTY_REQUIRE_DB=0
# Drop A′ coalitions larger than this (shared-vendor SAN junk). Default 5.
NOVELTY_MAX_COALITION=5
# Drop a brand from A′ when it has this many distinct co-named partners (learned packing hub).
# 0 disables the degree gate.
# NOVELTY_MAX_PARTNER_DEGREE=25
# Drop a brand from A′ when its solo+multi watchlist appearances reach this (IDF / mega-apex).
# Amazon warms on this clock (almost never shares a cert with another watchlist brand). 0 disables.
# NOVELTY_MAX_BRAND_DF=25
# Listen-first: mute alerts.jsonl until wall time and/or N multi-brand events (0 = off).
# Product default 6h so a fresh novelty.db does not page AWS×customer.
NOVELTY_CALIBRATE_SECS=21600
# NOVELTY_CALIBRATE_EVENTS=0
# Optional learning feed of first-seen coalitions + degrees (not the product pager).
# NOVELTY_CANDIDATES=/var/lib/ct-firehose-filter/candidates.jsonl
# Drop A′ when the leaf cert has more SANs than this (Firebase mega-SAN packing). Default 32.
# NOVELTY_MAX_SANS=32
# Chunk size (256 MiB) and total alert budget (20 GiB); gzip sealed chunks.
NOVELTY_ALERTS_MAX_BYTES=268435456
NOVELTY_ALERTS_MAX_TOTAL_BYTES=21474836480
NOVELTY_ALERTS_GZIP=1

# Research archive (pre-novelty matches). Rotate+gzip; prune oldest sealed chunks at 50 GiB.
# ARCHIVE_DIR=/var/lib/ct-firehose-filter/archive
# ARCHIVE_MAX_BYTES=268435456
# ARCHIVE_MAX_TOTAL_BYTES=53687091200
# ARCHIVE_DISK_WARN_BYTES=107374182400
# GIT_SHA=

# Status HTTP (Compose publishes 127.0.0.1:9100 only). Empty/off disables.
# STATUS_BIND=0.0.0.0:9100
