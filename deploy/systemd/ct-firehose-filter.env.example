# Drop at /etc/ct-firehose-filter/env (mode 0640).
# Production: in-process A′ novelty + quiet logs. Never set EGRESS=stdout here.

EGRESS=novelty
WATCHLIST_FILE=/var/lib/ct-firehose-filter/domains.txt
SUPPRESS_FILE=/var/lib/ct-firehose-filter/suppress.txt
GLUE_FILE=/var/lib/ct-firehose-filter/glue.txt
CERTSTREAM_URL=ws://127.0.0.1:8080/
NOVELTY_DB=/var/lib/ct-firehose-filter/novelty.db
NOVELTY_ALERTS=/var/lib/ct-firehose-filter/alerts.jsonl
NOVELTY_REQUIRE_DB=0
NOVELTY_TIERS=A
NOVELTY_MAX_COALITION=5
NOVELTY_ALERTS_MAX_BYTES=268435456
NOVELTY_ALERTS_MAX_TOTAL_BYTES=21474836480
NOVELTY_ALERTS_GZIP=1
CHANNEL_CAPACITY=4096
BATCH_MAX_MESSAGES=10
FLUSH_INTERVAL_SECS=5
RECONNECT_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=60000
PROGRESS_INTERVAL_SECS=300
WATCHLIST_RELOAD_SECS=3600
# Host loopback scrape: curl -s http://127.0.0.1:9100/status | jq
# (systemd binds on the host — use 127.0.0.1; Compose uses 0.0.0.0 inside the container)
STATUS_BIND=127.0.0.1:9100
# Research archive — see docs/ARCHIVE.md (default on for EGRESS=novelty)
ARCHIVE_DIR=/var/lib/ct-firehose-filter/archive
ARCHIVE_MAX_BYTES=268435456
ARCHIVE_DISK_WARN_BYTES=107374182400
RUST_LOG=warn
