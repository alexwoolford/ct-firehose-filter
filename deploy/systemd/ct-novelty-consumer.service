[Unit]
Description=CT novelty consumer (SQS MatchEvents → SQLite A′ → alerts)
Documentation=file:///usr/local/share/doc/ct-firehose-filter/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ctfilter
Group=ctfilter
WorkingDirectory=/var/lib/ct-firehose-filter
EnvironmentFile=-/etc/ct-firehose-filter/novelty.env
# Fail closed when NOVELTY_REQUIRE_DB=1: DB must already exist (restore from S3 after wipe).
ExecStartPre=/bin/bash -c 'if [[ "${NOVELTY_REQUIRE_DB:-1}" == "1" ]]; then test -f "${NOVELTY_DB}"; fi'
ExecStart=/usr/local/bin/ct-novelty-consumer
Restart=on-failure
RestartSec=5
Nice=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
