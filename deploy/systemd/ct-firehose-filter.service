[Unit]
Description=CT firehose edge filter (CertStream → watchlist → SQS)
Documentation=https://github.com/alexwoolford/ct-firehose-filter
After=network-online.target certstream-server-go.service
Requires=certstream-server-go.service
Wants=network-online.target

[Service]
Type=simple
User=ctfilter
Group=ctfilter
WorkingDirectory=/var/lib/ct-firehose-filter
EnvironmentFile=-/etc/ct-firehose-filter/env
# Prefer the local sidecar lite stream; Calidog is best-effort only.
Environment=CERTSTREAM_URL=ws://127.0.0.1:8080/
Environment=EGRESS=sqs
Environment=RUST_LOG=warn
ExecStart=/usr/local/bin/ct-firehose-filter
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
