[Unit]
Description=CT novelty replay (MatchEvent JSONL → SQLite deltas → alerts)
Documentation=file:///var/lib/ct-firehose-filter/docs/SIGNAL.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ctfilter
Group=ctfilter
WorkingDirectory=/var/lib/ct-firehose-filter
EnvironmentFile=-/etc/ct-firehose-filter/novelty.env
# Fail closed when NOVELTY_REQUIRE_DB=1 (default in novelty.env): DB must already exist.
ExecStartPre=/bin/bash -c 'if [[ "${NOVELTY_REQUIRE_DB:-0}" == "1" ]]; then test -f "$NOVELTY_DB"; fi'
ExecStart=/usr/local/bin/ct-novelty-replay ${NOVELTY_INPUT}
Nice=10

[Install]
WantedBy=multi-user.target
