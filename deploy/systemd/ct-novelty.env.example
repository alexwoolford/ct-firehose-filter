# Novelty consumer (SQS → SQLite A′ deltas → alerts JSONL / optional alerts queue).
# Drop at /etc/ct-firehose-filter/novelty.env (mode 0640).

# Raw MatchEvent queue (same URL the edge filter publishes to).
SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/123456789012/ct-matches
# Optional second queue for A′ alerts only (leave empty for file-only).
# NOVELTY_ALERTS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/123456789012/ct-alerts

# Durable path on Oracle boot/block volume — never /tmp in production.
NOVELTY_DB=/var/lib/ct-firehose-filter/novelty.db
NOVELTY_ALERTS=/var/lib/ct-firehose-filter/alerts.jsonl
# Refuse start if DB missing (prevents accidental cold-start flood after wipe).
# First boot: set 0 once to create, or restore from S3, then set 1.
NOVELTY_REQUIRE_DB=1
NOVELTY_TIERS=A
# Drop A′ coalitions larger than this (shared-vendor SAN junk). Default 5 ⇒ size ≥6 dropped.
NOVELTY_MAX_COALITION=5
# Rotate alerts.jsonl at 50MiB; keep 3 timestamped siblings (also see deploy/logrotate/).
NOVELTY_ALERTS_MAX_BYTES=52428800
NOVELTY_ALERTS_KEEP=3
NOVELTY_SKIP_ROUTINE=1
SUPPRESS_FILE=/var/lib/ct-firehose-filter/suppress.txt
GLUE_FILE=/var/lib/ct-firehose-filter/glue.txt
AWS_REGION=us-west-2

# Nightly S3 snapshot (us-west-2).
# NOVELTY_S3_URI=s3://your-bucket/ct-firehose/novelty.db

# Offline JSONL replay (ct-novelty-replay.service) still accepts:
# NOVELTY_INPUT=/var/lib/ct-firehose-filter/inbox/matches.jsonl
